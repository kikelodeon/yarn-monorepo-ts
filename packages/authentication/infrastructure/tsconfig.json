{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./dist", // Compiled files go to dist/
    "rootDir": "./src", // Only source files are included
    "composite": true, // Required for project references
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src", "../../_common/infrastructure/src/prisma/PrismaClient.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../_common/infrastructure" } // Uses compiled @kikerepo/common-infrastructure
  ]
}
