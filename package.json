{
  "name": "kikerepo",
  "private": true,
  "packageManager": "yarn@4.0.2",
  "workspaces": [
    "packages/*/**",
    "services/*"
  ],
  "scripts": {
    "up:postgres": "env-cmd -f services/service-postgreSQL/.env docker-compose -f services/service-postgreSQL/docker-compose.yml up -d",
    "down:postgres": "env-cmd -f services/service-postgreSQL/.env docker-compose -f services/service-postgreSQL/docker-compose.yml down ",
    "clear:postgres": "env-cmd -f services/service-postgreSQL/.env docker-compose -f services/service-postgreSQL/docker-compose.yml down --volumes --rmi all",
    "reset:postgres": "yarn down:postgres && yarn up:postgres",
    "hardreset:postgres": "yarn clear:postgres && yarn up:postgres",
    "up:redis": "env-cmd -f services/service-redis/.env docker-compose -f services/service-redis/docker-compose.yml up -d",
    "down:redis": "env-cmd -f services/service-redis/.env docker-compose -f services/service-redis/docker-compose.yml down",
    "clear:redis": "env-cmd -f services/service-redis/.env docker-compose -f services/service-redis/docker-compose.yml down --volumes --rmi all",
    "reset:redis": "yarn down:redis && yarn up:redis",
    "hardreset:redis": "yarn clear:redis && yarn up:redis",
    "up:kafka": "env-cmd -f services/service-kafka/.env docker-compose -f services/service-kafka/docker-compose.yml up -d",
    "down:kafka": "env-cmd -f services/service-kafka/.env docker-compose -f services/service-kafka/docker-compose.yml down",
    "build:kafka": "docker compose -f services/service-kafka/docker-compose.yml build --no-cache",
    "clear:kafka": "env-cmd -f services/service-kafka/.env docker-compose -f services/service-kafka/docker-compose.yml down --volumes --rmi all && docker image prune -af && docker volume prune -f && docker builder prune -af",
    "reset:kafka": "yarn down:kafka && yarn up:kafka",
    "hardreset:kafka": "yarn clear:kafka && yarn up:kafka",
    "build:authentication": "turbo run build --filter=@kikerepo/service-authentication",
    "dev:authentication": "yarn workspace @kikerepo/service-authentication dev",
    "docker:authentication": "env-cmd -f .env/development/.env docker-compose -f services/service-authentication/__docker/development/docker-compose.yml up -d",
    "docker:session": "env-cmd -f .env/development/.env docker-compose -f services/service-session/__docker/development/docker-compose.yml up -d",
    "docker:mailing": "env-cmd -f .env/development/.env docker-compose -f services/service-mailing/__docker/development/docker-compose.yml up -d",
    "build": "turbo run build",
    "buildasync": "turbo run build --parallel",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "clear": "yarn workspaces foreach --all run clear && rimraf .turbo node_modules",
    "uninstall": "turbo run uninstall && rimraf node_modules",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.4.5",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "env-cmd": "^10.1.0",
    "inversify": "^6.2.1",
    "prisma": "^6.2.1",
    "reflect-metadata": "^0.2.2"
  }
}
