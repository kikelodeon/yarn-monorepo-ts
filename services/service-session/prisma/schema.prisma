// services/service-authentication/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id          String    @id
  userId      String
  accessToken String
  fingerPrint String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  locations   Location[]
}

model Location {
  id        String   @id @default(uuid())
  ip        String
  country   String?
  region    String?
  city      String?
  latitude  Float?
  longitude Float?
  scannedAt   DateTime  @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
  sessionId String
}
